#include <windows.h>
#include "resource.h"

IDI_SNIPTEXT ICON "..\\assets\\SnipText.ico"

// The manifest is embedded rather than shipped alongside, so the executable
// stays a single self-contained file. It declares three things:
//   * comctl32 version 6, for the modern trackbar and task dialog
//   * Per-Monitor-V2 DPI awareness, so every coordinate is a real pixel
//   * Windows 10/11 compatibility, so the OS does not apply shims
1 RT_MANIFEST "SnipText.manifest"

// Fetched at build time rather than committed: a 4 MB binary blob does not
// belong in the history, and it is the same file for everyone. See
// scripts/fetch-tessdata.* and the CMake target that calls it.
#ifdef SNIPTEXT_WITH_TESSERACT
IDR_TESSDATA_ENG RCDATA "..\\assets\\eng.traineddata"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION     SNIPTEXT_VERSION_COMMA
PRODUCTVERSION  SNIPTEXT_VERSION_COMMA
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Mark Pelayo"
            VALUE "FileDescription",  "SnipTextProUltra"
            VALUE "FileVersion",      SNIPTEXT_VERSION_STRING
            VALUE "InternalName",     "SnipTextProUltra"
            VALUE "LegalCopyright",   "MIT licence"
            VALUE "OriginalFilename", "SnipTextProUltra.exe"
            VALUE "ProductName",      "SnipTextProUltra"
            VALUE "ProductVersion",   SNIPTEXT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
